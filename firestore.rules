rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Each family's log lives under a random 19-character household code.
    // Only signed-in app users can read or write, and only inside a household path.

    // One document per day of doses.
    match /households/{household}/days/{day} {
      allow read: if request.auth != null && household.size() == 19;
      allow write: if request.auth != null
                   && household.size() == 19
                   && day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                   && request.resource.data.keys().hasOnly(['date', 'month', 'slots']);
    }

    // Phones that turned on missed-dose alerts.
    match /households/{household}/subs/{sub} {
      allow read, delete: if request.auth != null && household.size() == 19;
      allow create, update: if request.auth != null
                            && household.size() == 19
                            && sub.matches('^[0-9a-f]{40}$')
                            && request.resource.data.keys().hasOnly(['endpoint', 'keys', 'created'])
                            && request.resource.data.endpoint.matches('^https://.{10,600}$');
    }

    // One marker per alert sent, so a missed dose is only announced once.
    match /households/{household}/alerts/{alert} {
      allow read: if request.auth != null && household.size() == 19;
      allow create: if request.auth != null
                    && household.size() == 19
                    && alert.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}_[a-z]+$')
                    && request.resource.data.keys().hasOnly(['at']);
    }

    // Problem reports from David's apps (script errors, taps that did nothing). No app data.
    // Apps can only add entries; the collector Action reads and removes them.
    match /diag/{id} {
      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['app', 'at', 'kind', 'msg', 'state', 'crumbs'])
                    && request.resource.data.app in ['medmed', 'puzzpuzz', 'pk', 'curb', 'emulatordesk', 'solar']
                    && request.resource.data.kind.size() <= 24
                    && request.resource.data.msg.size() <= 400
                    && request.resource.data.state.size() <= 1500
                    && request.resource.data.crumbs.size() <= 2500;
      allow read, delete: if request.auth != null;
    }
  }
}
